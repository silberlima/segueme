{
  "uid": "segueme-backend",
  "title": "Segue-me · Backend",
  "tags": ["segueme"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Disponibilidade",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [{ "expr": "up{job=\"segueme-backend\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA DO AR", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "NO AR", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requisições por segundo",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"segueme-backend\"}[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Taxa de erro 5xx",
      "description": "Alerta em 5% (observabilidade/alertas.yml).",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"segueme-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"segueme-backend\"}[5m])), 0.001)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "403 por minuto",
      "description": "RNF-06: volume atípico indica claim territorial ausente ou errada no Keycloak.",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "60 * sum(rate(http_server_requests_seconds_count{job=\"segueme-backend\",status=\"403\"}[10m]))",
          "legendFormat": "403/min"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Conexões na fila",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [{ "expr": "hikaricp_connections_pending{job=\"segueme-backend\"}", "legendFormat": "pendentes" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latência por endpoint (p95)",
      "description": "RNF-09/10. Alerta em 2s.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"segueme-backend\"}[5m]))))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Requisições por status",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"segueme-backend\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Endpoints mais chamados",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"segueme-backend\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "JVM: heap usado e threads",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"segueme-backend\",area=\"heap\"})",
          "legendFormat": "heap usado"
        },
        { "expr": "jvm_threads_live_threads{job=\"segueme-backend\"}", "legendFormat": "threads vivas" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Pool de conexões (Hikari)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "segueme-prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"segueme-backend\"}", "legendFormat": "ativas" },
        { "expr": "hikaricp_connections_idle{job=\"segueme-backend\"}", "legendFormat": "ociosas" },
        { "expr": "hikaricp_connections_pending{job=\"segueme-backend\"}", "legendFormat": "na fila" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
