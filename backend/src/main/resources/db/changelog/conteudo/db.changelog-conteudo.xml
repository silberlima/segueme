<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="conteudo-0001-create-tables" author="segueme">
        <createTable tableName="palestra">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="numero" type="int">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tema" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="palestrante">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="pessoa_id" type="uuid">
                <constraints foreignKeyName="fk_palestrante_pessoa" references="pessoa(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="designacao_palestra">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="encontro_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_designacao_palestra_encontro" references="encontro(id)"/>
            </column>
            <column name="palestra_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_designacao_palestra_palestra" references="palestra(id)"/>
            </column>
            <column name="palestrante_id" type="uuid">
                <constraints foreignKeyName="fk_designacao_palestra_palestrante" references="palestrante(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="designacao_palestra" columnNames="encontro_id, palestra_id"
                              constraintName="uk_designacao_palestra_encontro_palestra"/>
        <createIndex tableName="designacao_palestra" indexName="idx_designacao_palestra_encontro">
            <column name="encontro_id"/>
        </createIndex>
    </changeSet>

