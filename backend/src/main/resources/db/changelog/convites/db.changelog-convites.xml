<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Fase 7: o convite é o próprio integrante_equipe (RN-CONVITE-01) — estas colunas guardam
         o ciclo de convite/aceite/recusa/reenvio sobre o vínculo já criado na Fase 6. -->
    <changeSet id="convites-0001-add-columns" author="segueme">
        <addColumn tableName="integrante_equipe">
            <column name="data_envio_convite" type="timestamp with time zone"/>
            <column name="data_resposta" type="timestamp with time zone"/>
            <column name="justificativa_recusa" type="varchar(1000)"/>
            <column name="reenvios" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
