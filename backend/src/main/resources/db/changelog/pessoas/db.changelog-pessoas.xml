    <!--
        Vínculo entre a Pessoa e o usuário que a representa no Keycloak (o `sub` do token). É o que
        permite ao perfil Seguidor ver e alterar os *próprios* dados: sem esta coluna não há como
        responder "quem sou eu" a partir do token.

        Nulo é o normal: a maioria das pessoas do cadastro nunca acessa o sistema. A unicidade
        impede que dois registros de Pessoa apontem para o mesmo usuário, o que tornaria "meus
        dados" ambíguo. Quem preenche a coluna ainda é decisão em aberto (pendência #3) — hoje é
        administrativo, fora do produto.
    -->
    <changeSet id="pessoas-0004-vinculo-usuario" author="segueme">
        <addColumn tableName="pessoa">
            <column name="usuario_id" type="varchar(100)"/>
        </addColumn>
        <addUniqueConstraint tableName="pessoa" columnNames="usuario_id"
                             constraintName="uk_pessoa_usuario_id"/>
    </changeSet>

    <!--
        CPF, Instagram e endereço residencial (decisão do PO). CPF e endereço são obrigatórios;
        Instagram não.

        As colunas entram nulas, são preenchidas e só então recebem NOT NULL: as pessoas semeadas
        em `pessoas-0003` já existem nos bancos de desenvolvimento, e um changeset que já rodou não
        roda de novo — editá-lo quebraria o checksum do Liquibase. Por isso o backfill vive aqui, e
        não lá.

        O CPF é a chave natural que faltava ao "cadastro nacional único, nunca duplicado por
        paróquia" (RN-PESSOA-01): guardado só com os 11 dígitos, para que a unicidade não seja
        contornada pela pontuação.
    -->
    <changeSet id="pessoas-0005-cpf-instagram-endereco" author="segueme">
        <addColumn tableName="pessoa">
            <column name="cpf" type="varchar(11)"/>
            <column name="instagram" type="varchar(30)"/>
            <column name="endereco_cep" type="varchar(9)"/>
            <column name="endereco_logradouro" type="varchar(255)"/>
            <column name="endereco_numero" type="varchar(20)"/>
            <column name="endereco_complemento" type="varchar(255)"/>
            <column name="endereco_bairro" type="varchar(255)"/>
            <column name="endereco_cidade" type="varchar(255)"/>
            <column name="endereco_uf" type="varchar(2)"/>
        </addColumn>

