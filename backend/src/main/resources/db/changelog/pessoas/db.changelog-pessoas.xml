<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="pessoas-0001-create-tables" author="segueme">
        <createTable tableName="pessoa">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome_completo" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data_nascimento" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="telefone" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="estado_civil" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="paroquia_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_pessoa_paroquia" references="paroquia(id)"/>
            </column>
            <column name="situacao" type="varchar(20)" defaultValue="PRE_INSCRITO">
                <constraints nullable="false"/>
            </column>
            <column name="alergias" type="varchar(255)"/>
            <column name="restricao_alimentar" type="varchar(255)"/>
            <column name="medicacao_uso_continuo" type="varchar(255)"/>
            <column name="contato_emergencia_nome" type="varchar(255)"/>
            <column name="contato_emergencia_telefone" type="varchar(30)"/>
            <column name="contato_emergencia_parentesco" type="varchar(100)"/>
            <column name="indicado_por_id" type="uuid">
                <constraints foreignKeyName="fk_pessoa_indicado_por" references="pessoa(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="pessoa" indexName="idx_pessoa_paroquia">
            <column name="paroquia_id"/>
        </createIndex>
        <createIndex tableName="pessoa" indexName="idx_pessoa_nome_completo">
            <column name="nome_completo"/>
        </createIndex>

        <createTable tableName="competencia">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="pessoa_competencia">
            <column name="pessoa_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_pessoa_competencia_pessoa" references="pessoa(id)"/>
            </column>
            <column name="competencia_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_pessoa_competencia_competencia"
                             references="competencia(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="pessoa_competencia" columnNames="pessoa_id, competencia_id"
                        constraintName="pk_pessoa_competencia"/>

        <createTable tableName="casal">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pessoa1_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_casal_pessoa1" references="pessoa(id)"/>
            </column>
            <column name="pessoa2_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_casal_pessoa2" references="pessoa(id)"/>
            </column>
            <column name="data_vinculo" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="casal" indexName="idx_casal_pessoa1">
            <column name="pessoa1_id"/>
        </createIndex>
        <createIndex tableName="casal" indexName="idx_casal_pessoa2">
            <column name="pessoa2_id"/>
        </createIndex>

        <createTable tableName="historico_evento">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pessoa_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_historico_evento_pessoa" references="pessoa(id)"/>
            </column>
            <column name="tipo" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="data_evento" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="varchar(500)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="historico_evento" indexName="idx_historico_evento_pessoa">
            <column name="pessoa_id"/>
        </createIndex>
    </changeSet>

