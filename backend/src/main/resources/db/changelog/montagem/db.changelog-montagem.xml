        </insert>
        <insert tableName="equipe_competencia">
            <column name="equipe_id" value="00000000-0000-4000-8000-000000000704"/>
            <column name="competencia_id" value="00000000-0000-4000-8000-000000000402"/>
        </insert>
        <insert tableName="equipe_competencia">
            <column name="equipe_id" value="00000000-0000-4000-8000-000000000706"/>
