{
  "realm": "segueme",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "NACIONAL" },
      { "name": "DIOCESE" },
      { "name": "SETORIAL" },
      { "name": "PAROQUIA" },
